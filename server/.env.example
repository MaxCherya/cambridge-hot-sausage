DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database — leave empty for SQLite (dev default)
# Set to postgres://user:pass@host:5432/dbname on prod
DATABASE_URL=

# Cache — leave empty for LocMemCache (dev default)
# Set to redis://127.0.0.1:6379/1 on prod
REDIS_URL=
